{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oheco.github.io/oheco-packages/schema/v4/index.schema.json",
  "title": "oheco index v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "packages"],
  "properties": {
    "schema_version": {"const": 4},
    "generated_at": {"type": "string", "format": "date-time"},
    "packages": {"type": "array", "items": {"$ref": "package.schema.json"}}
  }
}
