{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oheco.github.io/oheco-packages/schema/v2/package.schema.json",
  "title": "oheco package descriptor v2 (accepts v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "upstream",
    "repository",
    "maintainers",
    "license",
    "latest",
    "versions"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._+-]{0,127}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/oheco/[A-Za-z0-9][A-Za-z0-9._+-]{0,127}/?$"
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "github"
        ],
        "properties": {
          "github": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "latest": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+-[a-z0-9]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "artifacts"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
          },
          "upstream_version": {
            "type": "string"
          },
          "artifacts": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z0-9]+-[a-z0-9]+$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/artifact"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size",
        "format",
        "strip_components",
        "binaries"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "format": {
          "enum": [
            "tar.gz",
            "zip"
          ]
        },
        "strip_components": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "binaries": {
          "type": "object",
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)[^\\u0000]+$"
          }
        },
        "launchers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "versions": {
            "items": {
              "properties": {
                "artifacts": {
                  "additionalProperties": {
                    "properties": {
                      "format": {
                        "const": "tar.gz"
                      },
                      "binaries": {
                        "minProperties": 1
                      }
                    },
                    "not": {
                      "required": [
                        "launchers"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
